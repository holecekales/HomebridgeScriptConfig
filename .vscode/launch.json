{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Homebridge Dev",
            "program": "${workspaceFolder}/node_modules/homebridge/bin/homebridge",
            "args": ["-I", "-D", "-U", "dev"],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "sourceMaps": true,
            "env": {
                "NODE_ENV": "development"
            },
            "runtimeArgs": ["--nolazy"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}