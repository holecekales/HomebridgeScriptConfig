{
  "pluginAlias": "ScriptConfig",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "OWM_API_KEY": {
        "title": "Owm Api Key. Get it at https://home.openweathermap.org/api_keys",
        "type": "string"
      },
      "CITY_NAME": {
        "title": "City Name",
        "type": "string",
        "default": "Kirkland"
      },
      "LATITUDE": {
        "title": "Latitude [Deg]",
        "type": "string",
        "default": "47.6858"
      },
      "LONGITUDE": {
        "title": "Longitude [Deg]",
        "type": "string",
        "default": "-122.2087"
      },
      "TIMEZONE": {
        "title": "IANA time zone identifier. Find it at https://time.is",
        "type": "string",
        "default": "America/Los_Angeles "
      },
      "COUNTRY_NAME": {
        "title": "Country Name",
        "type": "string",
        "default": "USA"
      },
      "SUN_ANGLE_MIN": {
        "title": "Sun Angle Min [Deg]" ,
        "type": "string",
        "default": "7"
      },
      "SUN_ANGLE_MAX": {
        "title": "Sun Angle Max [Deg]",
        "type": "string",
        "default": "42"
      },
      "AZIMUTH_MIN": {
        "title": "Azimuth Min [Deg]",
        "type": "string",
        "default": "200"
      },
      "AZIMUTH_MAX": {
        "title": "Azimuth Max [Deg]",
        "type": "string",
        "default": "310"
      },
      "BRITNESS_CLOSE_THRESHOLD": {
        "title": "Cloud Cover Threshold [%]",
        "type": "string",
        "default": "33"
      },
      "ACCESSORY_ID": {
        "title": "Accessory Id",
        "type": "string",
        "default": "sun-incline"
      },
      "HOMEBRIDGE_HOST": {
        "title": "Homebridge Host",
        "type": "string",
        "default": "http://homebridge.local"
      },
      "HOMEBRIDGE_PORT": {
        "title": "Homebridge Port",
        "type": "string",
        "default": "51828"
      }
    },
    "required": ["OWM_API_KEY"]
  }
}

