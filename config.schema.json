{
  "pluginAlias": "ScriptConfig",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Script Config"
      },
      "scriptPath": {
        "title": "Python Script Path",
        "type": "string",
        "default": "/home/ales/scripts/myscript.py"
      },
      "scriptArgs": {
        "title": "Script Arguments",
        "type": "string",
        "default": ""
      },
      "runOnStartup": {
        "title": "Run script at startup",
        "type": "boolean",
        "default": false
      }
    },
    "required": ["scriptPath"]
  }
}

