{
  "name": "homebridge-script-config",
  "displayName": "Script Config",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "A Homebridge plugin to configure and trigger Python scripts.",
  "author": "Ales Holecek",
  "license": "Apache-2.0",
  "homepage": "https://github.com/holecekales/HomebridgeScriptConfig/blob/latest/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/holecekales/HomebridgeScriptConfig.git"
  },
  "bugs": {
    "url": "https://github.com/holecekales/HomebridgeScriptConfig/issues"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "dev": "nodemon --watch src --signal SIGTERM --exec 'npx homebridge -U dev'" 
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "homebridge": "^2.0.0-beta.0",
    "homebridge-config-ui-x": "^4.73.0",
    "homebridge-lib": "^7.1.4",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
